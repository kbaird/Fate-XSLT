<?xml version="1.0" encoding="UTF-8"?>
<x:description
  xmlns:x="http://www.jenitennison.com/xslt/xspec"
  stylesheet="../../xslt/do_fotft_html.xsl"
  run-as="external">

  <x:scenario label="a full Do: Fate of the Flying Temple page renders the Do:FotFT layout with every section">
    <x:context>
      <character>
        <id>
          <charname>Curious Cat</charname>
          <playername>Morgan Baird</playername>
          <description>Red-haired girl, wearing clothing that looks like the coat of a leopard.</description>
        </id>
        <refresh free-stunts="2"/>
        <aspects>
          <aspect type="Avatar">Ooh... What's That?</aspect>
          <aspect type="Banner-Trouble">Easily Distracted</aspect>
          <aspect type="Dragon">Breathes White Fire and Eats Blueberries</aspect>
          <aspect>I'll Find a Way In!</aspect>
          <aspect/>
        </aspects>
        <approaches>
          <approach rating="2" name="Careful"/>
          <approach rating="3" name="Clever"/>
          <approach rating="0" name="Flashy"/>
          <approach rating="1" name="Forceful"/>
          <approach rating="1" name="Quick"/>
          <approach rating="2" name="Sneaky"/>
        </approaches>
        <stunts>
          <stunt name="Cheshire Catting">Because I am like the Cheshire Cat, I Sneakily Overcome at +2 when being invisible or intangible would help.</stunt>
          <stunt name="Cheshire Grin">Because of my grin, I Flashily Create an Advantage at +2 when revealing myself suddenly.</stunt>
        </stunts>
        <consequences>
          <consequence severity="Mild">Bruised</consequence>
          <consequence severity="Moderate">Scratched Up</consequence>
          <consequence severity="Severe">Taken Out</consequence>
        </consequences>
        <notes>Carries a spyglass and greets people with high-fives.</notes>
      </character>
    </x:context>
    <x:expect label="page chrome, sections, Do:FotFT logo, refresh, id fieldsets, approaches, aspects, stunts, single-track stress, consequences, and notes render"
      test="string(/html/head/title) = 'Curious Cat'
            and string(/html/body/h1) = 'Curious Cat'
            and contains(string(/html/head/style), './css/fate.css')
            and contains(string(/html/head/style), './css/fae.css')
            and contains(string(/html/head/style), './css/do_fotft.css')
            and count(/html/body//section[@id='id']) = 1
            and count(/html/body//section[@id='fate-logo']) = 1
            and count(/html/body//section[@id='aspects']) = 1
            and count(/html/body//section[@id='skills']) = 1
            and count(/html/body//section[@id='stunts']) = 1
            and count(/html/body//section[@id='stress']) = 1
            and count(/html/body//section[@id='consequences']) = 1
            and count(/html/body//span[@id='do_fotft']) = 1
            and contains(string(/html/body//span[@id='do_fotft']), 'Do: Fate of the Flying&#160;Temple')
            and count(/html/body//dl[@id='refresh']) = 1
            and count(/html/body//dl[@id='current-fate-points']) = 1
            and string(/html/body//dl[@id='refresh']/dd) = '3'
            and string(/html/body//dl[@id='current-fate-points']/dd) = '3'
            and contains(string(/html/body//fieldset[@id='name']), 'Curious Cat')
            and contains(string(/html/body//fieldset[@id='description']), 'Red-haired girl')
            and count(/html/body//fieldset[@id='affiliation']) = 0
            and count(/html/body//table[@id='approaches']) = 1
            and count(/html/body//dl[contains(@class,'approaches')]) = 6
            and count(/html/body//dl[@class='approaches']/dt[.='Clever']) = 1
            and count(/html/body//dl[@class='approaches']/dd[.='+3']) = 1
            and count(/html/body//table[@id='aspects_table']) = 1
            and count(/html/body//fieldset[contains(@class,'aspect')]) = 5
            and count(/html/body//legend[span='Avatar']) = 1
            and count(/html/body//legend[span='Banner Trouble']) = 1
            and count(/html/body//legend[span='Dragon']) = 1
            and count(/html/body//span[@class='content']) = 2
            and count(/html/body//fieldset[@class='stunt']) = 2
            and contains(string(/html/body//section[@id='stunts']), 'Cheshire Catting')
            and count(/html/body//table[@id='stress_table']) = 1
            and count(/html/body//table[@id='stress_table']//th[contains(@class,'sectionheader') and .='Stress']) = 1
            and count(/html/body//table[@id='stress_table']//th[@colspan='5']) = 1
            and string(/html/body//table[@id='stress_table']//tr[th[.='Stress']]/following-sibling::tr[1]) = '123'
            and count(/html/body//fieldset[contains(@class,'consequence')]) = 3
            and count(/html/body//legend[contains(.,'Mild (2)')]) = 1
            and count(/html/body//legend[contains(.,'Moderate (4)')]) = 1
            and count(/html/body//legend[contains(.,'Severe (6)')]) = 1
            and count(/html/body//fieldset[contains(@class,'consequence') and contains(.,'Bruised')]) = 1
            and count(/html/body//fieldset[contains(@class,'consequence') and contains(.,'Scratched Up')]) = 1
            and count(/html/body//fieldset[contains(@class,'consequence') and contains(.,'Taken Out')]) = 1
            and contains(string(/html/body//section[@id='consequences']//tfoot), 'F = Free, R? = Recovering?')
            and contains(string(/html/body), 'Carries a spyglass')
            and count(/html/body//p[@id='copyright']) = 0"/>
  </x:scenario>

  <x:scenario label="the id section renders the name fieldset with a quoted nickname and the description fieldset">
    <x:context>
      <character>
        <id>
          <charname nickname="Kitty">Curious Cat</charname>
          <playername>Morgan Baird</playername>
          <description>Red-haired girl.</description>
        </id>
      </character>
    </x:context>
    <x:expect label="ID table with two labeled fieldsets and no affiliation fieldset"
      test="string(/html/body//section[@id='id']//th[contains(@class,'sectionheader')]) = 'ID'
            and count(/html/body//fieldset[@id='name']) = 1
            and contains(string(/html/body//fieldset[@id='name']), 'Curious Cat')
            and count(/html/body//fieldset[@id='name']//q) = 1
            and string(/html/body//fieldset[@id='name']//q) = 'Kitty'
            and count(/html/body//fieldset[@id='description']) = 1
            and contains(string(/html/body//fieldset[@id='description']), 'Red-haired girl')
            and count(/html/body//section[@id='id']//legend[contains(@class,'label')]) = 2
            and count(/html/body//fieldset[@id='affiliation']) = 0"/>
  </x:scenario>

  <x:scenario label="the do_fotft description fieldset renders even when description is empty">
    <x:context>
      <character>
        <id>
          <charname>Blithe Buffalo</charname>
          <playername>Jennifer Cornish</playername>
          <description/>
        </id>
      </character>
    </x:context>
    <x:expect label="name and description fieldsets both appear, with the description holding only its legend"
      test="count(/html/body//fieldset[@id='name']) = 1
            and count(/html/body//fieldset[@id='description']) = 1
            and string(/html/body//fieldset[@id='description']) = 'Description'
            and contains(string(/html/body//fieldset[@id='name']), 'Blithe Buffalo')"/>
  </x:scenario>

  <x:scenario label="approaches render one signed dl per approach inside the skills section">
    <x:context>
      <character>
        <approaches>
          <approach rating="0" name="Careful"/>
          <approach rating="2" name="Clever"/>
          <approach rating="3" name="Flashy"/>
          <approach rating="1" name="Forceful"/>
          <approach rating="1" name="Quick"/>
          <approach rating="2" name="Sneaky"/>
        </approaches>
      </character>
    </x:context>
    <x:expect label="approaches table with six dls and signed rating values"
      test="count(/html/body//table[@id='approaches']) = 1
            and count(/html/body//section[@id='skills']//dl[contains(@class,'approaches')]) = 6
            and count(/html/body//dl[@class='approaches']/dt[.='Careful']) = 1
            and count(/html/body//dl[@class='approaches']/dt[.='Sneaky']) = 1
            and count(/html/body//dl[@class='approaches']/dd[.='+0']) = 1
            and count(/html/body//dl[@class='approaches']/dd[.='+3']) = 1
            and count(/html/body//dl[@class='approaches']/dd) = 6
            and contains(string(/html/body//table[@id='approaches']//th[contains(@class,'sectionheader')]), 'Approaches')"/>
  </x:scenario>

  <x:scenario label="the refresh block honors the free-stunts budget of two and the base refresh">
    <x:context>
      <character>
        <refresh base="5" free-stunts="2"/>
        <stunts>
          <stunt name="Alpha">One.</stunt>
          <stunt name="Beta">Two.</stunt>
          <stunt name="Gamma">Three.</stunt>
        </stunts>
      </character>
    </x:context>
    <x:expect label="three stunts cost one point beyond the two free, so refresh and fate points are four"
      test="count(/html/body//dl[@id='refresh']) = 1
            and count(/html/body//dl[@id='current-fate-points']) = 1
            and contains(string(/html/body//dl[@id='refresh']/dt), 'Refresh')
            and contains(string(/html/body//dl[@id='current-fate-points']/dt), 'Current Fate Points')
            and string(/html/body//dl[@id='refresh']/dd) = '4'
            and string(/html/body//dl[@id='current-fate-points']/dd) = '4'
            and count(/html/body//section[@id='fate-logo']//dd[@class='box']) = 2"/>
  </x:scenario>

  <x:scenario label="the two free stunts cost nothing, leaving the default refresh of three intact">
    <x:context>
      <character>
        <refresh free-stunts="2"/>
        <stunts>
          <stunt name="Cheshire Catting">Sneakily Overcome at +2 when invisible helps.</stunt>
          <stunt name="&#160;">&#160;</stunt>
        </stunts>
      </character>
    </x:context>
    <x:expect label="refresh defaults to three and both boxes show three"
      test="string(/html/body//dl[@id='refresh']/dd) = '3'
            and string(/html/body//dl[@id='current-fate-points']/dd) = '3'"/>
  </x:scenario>

  <x:scenario label="stress renders the single FAE track of three boxes">
    <x:context>
      <character/>
    </x:context>
    <x:expect label="Stress header spanning five columns and a row of boxes 1, 2, 3"
      test="count(/html/body//table[@id='stress_table']) = 1
            and count(/html/body//table[@id='stress_table']//th[contains(@class,'sectionheader') and .='Stress']) = 1
            and count(/html/body//table[@id='stress_table']//th[@colspan='5']) = 1
            and count(/html/body//table[@id='stress_table']//tr[th[.='Stress']]/following-sibling::tr[1]/td) = 3
            and string(/html/body//table[@id='stress_table']//tr[th[.='Stress']]/following-sibling::tr[1]) = '123'"/>
  </x:scenario>

  <x:scenario label="consequences render the three standard tracks with filled text and recovery markers">
    <x:context>
      <character>
        <consequences>
          <consequence severity="Mild">Bruised</consequence>
          <consequence severity="Moderate">Scratched Up</consequence>
          <consequence severity="Severe">Taken Out</consequence>
        </consequences>
      </character>
    </x:context>
    <x:expect label="mild, moderate, and severe fieldsets hold their text and show the F/R? markers"
      test="count(/html/body//fieldset[contains(@class,'consequence')]) = 3
            and count(/html/body//legend[contains(.,'Mild (2)')]) = 1
            and count(/html/body//legend[contains(.,'Moderate (4)')]) = 1
            and count(/html/body//legend[contains(.,'Severe (6)')]) = 1
            and count(/html/body//fieldset[contains(@class,'consequence') and contains(.,'Bruised')]) = 1
            and count(/html/body//fieldset[contains(@class,'consequence') and contains(.,'Scratched Up')]) = 1
            and count(/html/body//fieldset[contains(@class,'consequence') and contains(.,'Taken Out')]) = 1
            and count(/html/body//fieldset[contains(@class,'consequence') and contains(.,'F&#9744;')]) = 3
            and count(/html/body//fieldset[contains(@class,'consequence') and contains(.,'R?&#9744;')]) = 2
            and contains(string(/html/body//section[@id='consequences']//tfoot//th), 'F = Free, R? = Recovering?')"/>
  </x:scenario>

  <x:scenario label="notes text renders in the body">
    <x:context>
      <character>
        <notes>Wants to escape by being nimble and cartwheeling in the air. Carries a spyglass.</notes>
      </character>
    </x:context>
    <x:expect label="the notes text appears raw in the body without a notes section wrapper"
      test="contains(string(/html/body), 'Carries a spyglass')
            and count(/html/body//section[@id='notes']) = 0"/>
  </x:scenario>

  <x:scenario label="aspects render Avatar, Banner-Trouble, and Dragon labels plus content-only aspects">
    <x:context>
      <character>
        <aspects>
          <aspect type="Avatar">Watch out! Coming through!</aspect>
          <aspect type="Banner-Trouble">The Shortest Distance is a Straight Line</aspect>
          <aspect type="Dragon">At Home in the Air or in the Water</aspect>
          <aspect>I'll Find a Way In!</aspect>
          <aspect/>
        </aspects>
      </character>
    </x:context>
    <x:expect label="five aspect fieldsets with translated labels and content spans for untyped aspects"
      test="count(/html/body//table[@id='aspects_table']) = 1
            and count(/html/body//fieldset[contains(@class,'aspect')]) = 5
            and count(/html/body//legend[span='Avatar']) = 1
            and count(/html/body//legend[span='Banner Trouble']) = 1
            and count(/html/body//legend[span='Dragon']) = 1
            and count(/html/body//span[@class='content']) = 2
            and string((/html/body//span[@class='content'])[1]) = 'I''ll Find a Way In!'
            and contains(string(/html/body//section[@id='aspects']), 'The Shortest Distance is a Straight Line')"/>
  </x:scenario>

</x:description>