<?xml version="1.0" encoding="UTF-8"?>
<x:description
  xmlns:x="http://www.jenitennison.com/xslt/xspec"
  stylesheet="../../xslt/fae_html.xsl"
  run-as="external">

  <x:scenario label="a full Fate Accelerated page renders every core section">
    <x:context>
      <character>
        <id>
          <charname>Malcolm Reynolds</charname>
          <affiliation>Serenity Crew</affiliation>
          <description>
            Kind of looks like Nathan Fillion c. 2002.
          </description>
        </id>
        <refresh base="5"/>
        <aspects>
          <aspect type="High-Concept">Captain of Serenity</aspect>
          <aspect type="Trouble">Things Don't Never Go Smooth</aspect>
          <aspect>Zoe's Former Browncoat Sergeant</aspect>
          <aspect>Lost Everything in Serenity Valley</aspect>
          <aspect>I Do the Job and I Get Paid</aspect>
        </aspects>
        <approaches>
          <approach rating="0" name="Careful"/>
          <approach rating="2" name="Clever"/>
          <approach rating="3" name="Flashy"/>
          <approach rating="1" name="Forceful"/>
          <approach rating="1" name="Quick"/>
          <approach rating="2" name="Sneaky"/>
        </approaches>
        <stunts>
          <stunt>Talks Like a Captain</stunt>
          <stunt>So Pretty</stunt>
        </stunts>
        <consequences>
          <consequence severity="Moderate">Scratched Up</consequence>
          <consequence severity="Severe">Taken Out</consequence>
        </consequences>
        <notes>
          "Space Cowboy". Same costume as 5 years ago.
        </notes>
      </character>
    </x:context>
    <x:expect label="title, subtitle, sections, and FAE text render"
      test="string(/html/head/title) = 'Malcolm Reynolds'
            and contains(string(/html/head/style), 'css/fae.css')
            and string(/html/body/h1) = 'Malcolm Reynolds'
            and string(/html/body//span[@id='fate-subtitle']) = 'Accelerated'
            and count(/html/body//section[@id='id']) = 1
            and count(/html/body//section[@id='fate-logo']) = 1
            and count(/html/body//section[@id='aspects']) = 1
            and count(/html/body//section[@id='skills']) = 1
            and count(/html/body//section[@id='stunts']) = 1
            and count(/html/body//section[@id='stress']) = 1
            and count(/html/body//section[@id='consequences']) = 1
            and contains(string(/html/body), 'Space Cowboy')
            and count(/html/body//acronym[@title='Fate Accelerated']) = 1
            and contains(string(/html/body/p[@id='copyright']), 'Evil Hat')"/>
  </x:scenario>

  <x:scenario label="the id section in fae mode renders name, affiliation, and description fieldsets">
    <x:context>
      <character>
        <id>
          <charname>Malcolm Reynolds</charname>
          <affiliation>Serenity Crew</affiliation>
          <description>
            Kind of looks like Nathan Fillion c. 2002.
          </description>
        </id>
      </character>
    </x:context>
    <x:expect label="ID table with name, affiliation, and description"
      test="count(/html/body//section[@id='id']//table) = 1
            and string(/html/body//section[@id='id']//th[contains(@class,'sectionheader')]) = 'ID'
            and string(/html/body//fieldset[@id='name']) = 'NameMalcolm Reynolds'
            and string(/html/body//fieldset[@id='affiliation']) = 'AffiliationSerenity Crew'
            and normalize-space(string(/html/body//fieldset[@id='description'])) =
                   'Description Kind of looks like Nathan Fillion c. 2002.'
            and count(/html/body//section[@id='id']//legend[contains(@class,'label')]) = 3"/>
  </x:scenario>

  <x:scenario label="approaches render as a table of approach dls with ratings">
    <x:context select="character/approaches">
      <character>
        <approaches>
          <approach rating="0" name="Careful"/>
          <approach rating="2" name="Clever"/>
          <approach rating="3" name="Flashy"/>
          <approach rating="1" name="Forceful"/>
          <approach rating="1" name="Quick"/>
          <approach rating="2" name="Sneaky"/>
        </approaches>
      </character>
    </x:context>
    <x:expect label="Approaches table with one dl per approach"
      test="count(//table[@id='approaches']) = 1
            and string(//th[contains(@class,'sectionheader')]) = 'Approaches'
            and count(//dl[contains(@class,'approaches')]) = 6
            and count(//dl[@class='approaches']/dt[.='Careful']) = 1
            and count(//dl[@class='approaches']/dd[.='+0']) = 1
            and count(//dl[@class='approaches']/dt[.='Flashy']) = 1
            and count(//dl[@class='approaches']/dd[.='+3']) = 1
            and count(//dl[@class='approaches']/dd) = 6"/>
  </x:scenario>

  <x:scenario label="a single approach renders its name and signed rating">
    <x:context select="character/approaches/approach">
      <character>
        <approaches>
          <approach rating="2" name="Sneaky"/>
        </approaches>
      </character>
    </x:context>
    <x:expect label="one dl.approaches with a +2 rating"
      test="count(//dl[contains(@class,'approaches')]) = 1
            and string(//dt) = 'Sneaky'
            and string(//dd) = '+2'"/>
  </x:scenario>

  <x:scenario label="the FAE stress table has a single track of three boxes">
    <x:context>
      <character/>
    </x:context>
    <x:call template="stress"/>
    <x:expect label="Stress section spanning the caller's three, boxes 1, 2, 3"
      test="count(//table[@id='stress_table']) = 1
            and count(//th[contains(@class,'sectionheader') and .='Stress']) = 1
            and count(//th[@colspan='3']) = 1
            and string(//tr[th[.='Stress']]/following-sibling::tr[1]) = '123'"/>
  </x:scenario>

  <x:scenario label="the default FAE consequences table marks only moderate and severe as recoverable">
    <x:context>
      <character/>
    </x:context>
    <x:call template="consequences"/>
    <x:expect label="three consequences fieldsets with the recovery marker on two"
      test="count(//th[contains(@class,'sectionheader') and .='Consequences']) = 1
            and count(//fieldset[contains(@class,'consequence')]) = 3
            and count(//fieldset[contains(@class,'consequence') and contains(.,'F&#9744;')]) = 3
            and count(//fieldset[contains(@class,'consequence') and contains(.,'R?&#9744;')]) = 2
            and string(//tfoot//th) = 'F = Free, R? = Recovering?'
            and count(//legend[contains(.,'Mild (2)')]) = 1
            and count(//legend[contains(.,'Moderate (4)')]) = 1
            and count(//legend[contains(.,'Severe (6)')]) = 1"/>
  </x:scenario>

  <x:scenario label="a stunt consequence adds a second mild consequence track">
    <x:context>
      <character>
        <stunts>
          <stunt consequence="Mild">Tough as Nails</stunt>
        </stunts>
      </character>
    </x:context>
    <x:call template="consequences"/>
    <x:expect label="four consequences fieldsets with two mild tracks"
      test="count(//fieldset[contains(@class,'consequence')]) = 4
            and count(//legend[contains(.,'Mild (2)')]) = 2
            and count(//legend[contains(.,'Moderate (4)')]) = 1
            and count(//legend[contains(.,'Severe (6)')]) = 1"/>
  </x:scenario>

  <x:scenario label="filled consequences place their text inside the matching severity fieldset">
    <x:context>
      <character>
        <consequences>
          <consequence severity="Mild">Bruised</consequence>
          <consequence severity="Moderate">Scratched Up</consequence>
          <consequence severity="Severe">Taken Out</consequence>
        </consequences>
      </character>
    </x:context>
    <x:call template="consequences"/>
    <x:expect label="each severity fieldset contains its consequence text"
      test="count(//fieldset[contains(@class,'consequence') and contains(.,'Bruised')]) = 1
            and count(//fieldset[contains(@class,'consequence') and contains(.,'Scratched Up')]) = 1
            and count(//fieldset[contains(@class,'consequence') and contains(.,'Taken Out')]) = 1"/>
  </x:scenario>

  <x:scenario label="the consequence template uses its label and tracks recovery for non-mild severities">
    <x:context>
      <character>
        <consequences>
          <consequence severity="Severe">Zip</consequence>
        </consequences>
      </character>
    </x:context>
    <x:call template="consequence">
      <x:param name="label">Wounded (8)</x:param>
      <x:param name="severity">Severe</x:param>
    </x:call>
    <x:expect label="custom label with recovery marker and the filled text"
      test="count(//fieldset[contains(@class,'consequence')]) = 1
            and count(//legend[contains(.,'Wounded (8)')]) = 1
            and count(//legend[contains(.,'R?&#9744;')]) = 1
            and string(//fieldset[contains(@class,'consequence')]) = 'Wounded (8)F&#9744; / R?&#9744;Zip'"/>
  </x:scenario>

  <x:scenario label="a fresh refresh shows the base value in both boxes">
    <x:context>
      <character>
        <refresh base="5"/>
      </character>
    </x:context>
    <x:call template="refresh"/>
    <x:expect label="both boxed values are 5"
      test="count(//dd[@class='box']) = 2 and //dd[@class='box'] = '5'"/>
  </x:scenario>

  <x:scenario label="refresh without an explicit base falls back to three">
    <x:context>
      <character/>
    </x:context>
    <x:call template="refresh"/>
    <x:expect label="both boxed values are 3"
      test="count(//dd[@class='box']) = 2 and //dd[@class='box'] = '3'"/>
  </x:scenario>

  <x:scenario label="the copyright template calls out Fate Accelerated and Evil Hat">
    <x:context>
      <character/>
    </x:context>
    <x:call template="fae-copyright"/>
    <x:expect label="a copyright paragraph with the FAE acronym"
      test="count(//p[@id='copyright']) = 1
            and string(//acronym[@title='Fate Accelerated']) = 'FAE'
            and contains(string(.), '©2013 Evil Hat Productions, LLC.')"/>
  </x:scenario>

</x:description>